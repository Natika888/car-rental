<odoo>

    <template id="report_car_rental_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <div class="page">
                        <h2>Car Rental</h2>

                        <p><strong>Customer:</strong> <span t-esc="doc.customer_id.name"/></p>
                        <p><strong>Car:</strong> <span t-esc="doc.car_id.name"/></p>
                        <p><strong>Pickup Location:</strong> <span t-esc="doc.pickup_location_id.name"/></p>
                        <p><strong>Return Location:</strong> <span t-esc="doc.return_location_id.name"/></p>
                        <p><strong>Start Date:</strong> <span t-esc="doc.date_start"/></p>
                        <p><strong>End Date:</strong> <span t-esc="doc.date_end"/></p>
                        <p><strong>Status:</strong> <span t-esc="doc.state"/></p>
                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>