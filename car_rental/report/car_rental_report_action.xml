<odoo>

    <record id="action_report_car_rental" model="ir.actions.report">
        <field name="name">Car Rental Report</field>
        <field name="model">car.rental</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">car_rental.report_car_rental_document</field>
        <field name="report_file">car_rental.report_car_rental_document</field>
        <field name="binding_model_id" ref="model_car_rental"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Car Rental - %s' % (object.id)</field>
    </record>

</odoo>