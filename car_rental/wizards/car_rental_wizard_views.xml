<odoo>

    <record id="view_car_rental_status_wizard_form" model="ir.ui.view">
        <field name="name">car.rental.status.wizard.form</field>
        <field name="model">car.rental.status.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Status">
                <group>
                    <field name="state"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_car_rental_status_wizard" model="ir.actions.act_window">
        <field name="name">Change Status</field>
        <field name="res_model">car.rental.status.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>