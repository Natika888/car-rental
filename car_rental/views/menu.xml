<odoo>

    <!-- ACTIONS -->

    <record id="action_car_product" model="ir.actions.act_window">
        <field name="name">Cars</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_car', '=', True)]</field>
         <field name="context">{'default_is_car': True}</field>
    </record>

    <record id="action_car_category" model="ir.actions.act_window">
        <field name="name">Car Categories</field>
        <field name="res_model">car.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rental_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">rental.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_car_rental" model="ir.actions.act_window">
        <field name="name">Rentals</field>
        <field name="res_model">car.rental</field>
        <field name="search_view_id" ref="view_car_rental_search"/>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_car_rental_root" name="Car Rental"
              web_icon="car_rental,static/description/icon.png"/>


    <menuitem id="menu_car_products"
              name="Cars"
              parent="menu_car_rental_root"
              action="action_car_product"/>

    <menuitem id="menu_car_category"
              name="Categories"
              parent="menu_car_rental_root"
              action="action_car_category"/>

    <menuitem id="menu_rental_location"
              name="Locations"
              parent="menu_car_rental_root"
              action="action_rental_location"/>

    <menuitem id="menu_car_rental"
              name="Rentals"
              parent="menu_car_rental_root"
              action="action_car_rental"/>


</odoo>